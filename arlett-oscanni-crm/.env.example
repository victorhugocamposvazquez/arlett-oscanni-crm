# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# Datos empresa (para facturas impresas/PDF)
NEXT_PUBLIC_BILLING_COMPANY_NAME=Tu Empresa S.L.
NEXT_PUBLIC_BILLING_COMPANY_NIF=B00000000
NEXT_PUBLIC_BILLING_COMPANY_ADDRESS=Calle Ejemplo 1
NEXT_PUBLIC_BILLING_COMPANY_CP=28001
NEXT_PUBLIC_BILLING_COMPANY_CITY=Madrid
NEXT_PUBLIC_BILLING_COMPANY_PROVINCE=Madrid
NEXT_PUBLIC_BILLING_COMPANY_IBAN=ES00 0000 0000 0000 0000 0000
# Opcional: URL abs. o ruta /... del logotipo en facturas (también en Ajustes → Datos de empresa)
# NEXT_PUBLIC_BILLING_LOGO_URL=/images/logo-arlett.png

# Obsoleto para el número de factura: ahora se usa N-OC-AAAA (ver lib/facturacion-numeracion.ts)
# NEXT_PUBLIC_BILLING_SERIE=RHB

# --- SMS recordatorios (SimplyBook → LabsMobile) ---
# Protege cron y webhooks en producción (también /api/cron/keepalive)
CRON_SECRET=genera-un-secreto-largo
SIMPLYBOOK_WEBHOOK_SECRET=genera-otro-secreto
LABSMOBILE_WEBHOOK_SECRET=secreto-para-los-ack-de-entrega

# SimplyBook.me (Admin API — Settings → API / API User Keys)
SIMPLYBOOK_COMPANY_LOGIN=tu-company-login
SIMPLYBOOK_USER_LOGIN=admin@tuempresa.com
# Contraseña de usuario o API User Key (api_user_key_...)
SIMPLYBOOK_USER_PASSWORD=
# Alternativa (solo company token; getBookings requiere user token):
# SIMPLYBOOK_API_KEY=

# LabsMobile (https://www.labsmobile.com → Configuración API)
# Usuario = email de la cuenta; token generado en Configuración API
LABSMOBILE_USERNAME=tu@email.com
LABSMOBILE_API_TOKEN=
# Remitente: alfanumérico (máx. 11 car.) o numérico (máx. 16 dígitos)
LABSMOBILE_SENDER=Arlett
# URL de ACK de entrega (incluye el secreto como query param)
# LABSMOBILE_ACK_URL=https://tu-dominio/api/webhooks/labsmobile?secret=LABSMOBILE_WEBHOOK_SECRET
# Modo simulado (1 = no envía ni gasta crédito, útil para pruebas)
# LABSMOBILE_TEST_MODE=1
